            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-[#FCF5D8] text-gray-700 text-xs font-black uppercase tracking-wider border-b border-gray-100">
                  <th className="p-4 sm:p-5">Mata Pelajaran</th>
                  <th className="p-4 sm:p-5">Tingkat Kelas</th>
                  <th className="p-4 sm:p-5">Jenis Perangkat</th>
                  <th className="p-4 sm:p-5">Guru Pengampu</th>
                  <th className="p-4 sm:p-5">Status</th>
                  <th className="p-4 sm:p-5">Link Google Drive</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-50 text-xs font-bold text-gray-800">
                {filtered.length === 0 ? (
                   <tr><td colSpan="6" className="p-8 text-center text-gray-400">Tidak ada perangkat ajar ditemukan.</td></tr>
                ) : (
                  filtered.map(p => (
                    <tr key={p.id} className="hover:bg-amber-50/30 transition">
                      <td className="p-4 sm:p-5 font-black text-gray-900">{p.mapel}</td>
                      <td className="p-4 sm:p-5 font-black text-purple-900">{p.kelas}</td>
                      <td className="p-4 sm:p-5 text-gray-600">{p.jenis}</td>
                      <td className="p-4 sm:p-5 text-gray-800">{p.guru}</td>
                      <td className="p-4 sm:p-5">
                        <span className={`px-3 py-1 rounded-full text-[10px] font-black ${p.status === 'Disetujui' ? 'bg-emerald-100 text-emerald-900' : 'bg-amber-100 text-amber-900'}`}>{p.status}</span>
                      </td>
                      <td className="p-4 sm:p-5">
                        {p.linkDrive ? (
                           <a href={p.linkDrive} target="_blank" rel="noreferrer" className="text-blue-500 hover:underline flex items-center space-x-1">
                              <Icon name="externalLink" size={14} /><span>Buka GDrive</span>
                           </a>
                        ) : (<span className="text-gray-400">-</span>)}
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      );
    };

    // ==================== DOKUMENTASI KEGIATAN ====================
    const DokumentasiView = ({ data, setData, showToast, searchQuery }) => {
      const [isModalOpen, setIsModalOpen] = useState(false);
      const [editId, setEditId] = useState(null);
      const [formData, setFormData] = useState({ judul: '', tanggal: '2026-10-01', kategori: 'Workshop Guru', deskripsi: '', linkDrive: '' });

      const filtered = data.dokumentasi.filter(d => d.judul.toLowerCase().includes(searchQuery.toLowerCase()) || d.kategori.toLowerCase().includes(searchQuery.toLowerCase()));

      const handleSave = () => {
        if (!formData.judul) return showToast('Isi judul kegiatan!');
        if (editId) { setData(prev => ({ ...prev, dokumentasi: prev.dokumentasi.map(d => d.id === editId ? { ...d, ...formData } : d) })); showToast('Dokumentasi diperbarui di Cloud!'); } 
        else { setData(prev => ({ ...prev, dokumentasi: [{ id: Date.now(), ...formData }, ...prev.dokumentasi] })); showToast('Dokumentasi ditambahkan ke Cloud!'); }
        setIsModalOpen(false); resetForm();
      };

      const resetForm = () => { setEditId(null); setFormData({ judul: '', tanggal: '2026-10-01', kategori: 'Workshop Guru', deskripsi: '', linkDrive: '' }); };
      const handleEdit = (d) => { setEditId(d.id); setFormData(d); setIsModalOpen(true); };
      const handleDelete = (id) => { setData(prev => ({ ...prev, dokumentasi: prev.dokumentasi.filter(d => d.id !== id) })); showToast('Dokumentasi dihapus.'); };

      return (
        <div>
          <div className="bg-white p-4 rounded-[2.5rem] shadow-sm border-2 border-white mb-6 flex flex-wrap gap-3 justify-between items-center">
            <button onClick={() => { resetForm(); setIsModalOpen(true); }} className="px-4 py-2.5 bg-[#E2F0E0] text-emerald-900 hover:bg-emerald-200 rounded-2xl font-black text-xs transition active:scale-95 border border-white flex items-center space-x-2">
              <Icon name="plus" size={16} /><span>Tambah Dokumentasi</span>
            </button>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {filtered.map(item => (
              <div key={item.id} className="bg-white p-6 rounded-[2.5rem] shadow-md border-2 border-white flex flex-col justify-between hover:shadow-lg transition">
                <div>
                  <div className="w-full h-36 bg-[#FAF8FE] border border-purple-50 rounded-[2rem] flex flex-col items-center justify-center mb-4 relative overflow-hidden shadow-inner">
                    <Icon name="image" size={42} className="text-purple-300 mb-1" />
                    <span className="px-3 py-1 bg-purple-100 rounded-full text-[10px] font-black text-[#6B42C8]">{item.kategori}</span>
                  </div>
                  <h3 className="font-black text-base text-gray-900 mb-1">{item.judul}</h3>
                  <p className="text-xs text-gray-400 font-bold mb-2">{formatDateDDMMYY(item.tanggal)}</p>
                  <p className="text-xs text-gray-600 line-clamp-2 font-medium">{item.deskripsi}</p>
                </div>
                <div className="flex justify-between items-center mt-4 pt-3 border-t border-gray-100">
                  {item.linkDrive ? (
                     <a href={item.linkDrive} target="_blank" rel="noreferrer" className="text-xs font-extrabold text-blue-600 hover:underline flex items-center space-x-1"><Icon name="externalLink" size={14} /> <span>Buka GDrive</span></a>
                  ) : <span className="text-gray-400 text-xs">-</span>}
                  <div className="flex items-center space-x-1">
                    <button onClick={() => handleEdit(item)} className="p-2 text-blue-500 hover:bg-blue-50 rounded-xl transition"><Icon name="edit" size={16}/></button>
                    <button onClick={() => handleDelete(item.id)} className="p-2 text-red-400 hover:bg-red-50 rounded-xl transition"><Icon name="trash" size={16}/></button>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <Modal isOpen={isModalOpen} onClose={() => setIsModalOpen(false)} title={editId ? "Edit Dokumentasi" : "Tambah Dokumentasi"}>
            <div className="space-y-4 text-xs font-bold text-gray-700">
              <div><label className="block mb-1">Judul Kegiatan</label><input type="text" className="w-full p-3.5 rounded-2xl bg-[#FAF8FE] border-2 border-[#E3D9F8] outline-none" value={formData.judul} onChange={e => setFormData({...formData, judul: e.target.value})} /></div>
              <div className="grid grid-cols-2 gap-3">
                <div><label className="block mb-1">Tanggal</label><input type="date" className="w-full p-3.5 rounded-2xl bg-[#FAF8FE] border-2 border-[#E3D9F8] outline-none" value={formData.tanggal} onChange={e => setFormData({...formData, tanggal: e.target.value})} /></div>
                <div><label className="block mb-1">Kategori</label><input type="text" className="w-full p-3.5 rounded-2xl bg-[#FAF8FE] border-2 border-[#E3D9F8] outline-none" value={formData.kategori} onChange={e => setFormData({...formData, kategori: e.target.value})} /></div>
              </div>
              <div><label className="block mb-1">Deskripsi Singkat</label><textarea className="w-full p-3.5 rounded-2xl bg-[#FAF8FE] border-2 border-[#E3D9F8] outline-none h-20" value={formData.deskripsi} onChange={e => setFormData({...formData, deskripsi: e.target.value})}></textarea></div>
              <div>
                <label className="block mb-1">Link Google Drive Dokumentasi</label>
                <input type="url" placeholder="https://drive.google.com/..." className="w-full p-3.5 rounded-2xl bg-[#FAF8FE] border-2 border-[#E3D9F8] outline-none" value={formData.linkDrive} onChange={e => setFormData({...formData, linkDrive: e.target.value})} />
              </div>
              <button onClick={handleSave} className="w-full py-4 bg-[#9B7BEA] text-white rounded-2xl font-black mt-2 hover:bg-[#8862E3] transition shadow-md flex justify-center items-center space-x-2"><Icon name="cloud" size={16}/><span>Simpan ke Cloud</span></button>
            </div>
          </Modal>
        </div>
      );
    };

    // ==================== MAIN APP ====================
    function App() {
      const [isAuthenticated, setIsAuthenticated] = useState(false);
      const [activeMenu, setActiveMenu] = useState('dashboard');
      const [searchQuery, setSearchQuery] = useState('');
      const [toastMessage, setToastMessage] = useState('');
      const [appData, setAppData] = useState(initialData);
      const [isMobileOpen, setIsMobileOpen] = useState(false);
      const [pdfPreview, setPdfPreview] = useState({ isOpen: false, name: '', data: '' });
      const [isCloudReady, setIsCloudReady] = useState(false);

      useEffect(() => {
        let unsubscribe = null;
        const initCloud = async () => {
          try {
            const config = getFirebaseConfig();
            if (!config) {
               console.log("Local mode only (No Firebase Config)");
               return;
            }
            
            const { initializeApp } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js");
            const { getAuth, signInAnonymously, signInWithCustomToken } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js");
            const { getFirestore, doc, setDoc, onSnapshot } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
            
            const app = initializeApp(config);
            const auth = getAuth(app);
            const db = getFirestore(app);
            
            const token = getInitialToken();
            if (token) {
               await signInWithCustomToken(auth, token);
            } else {
               await signInAnonymously(auth);
            }
            
            const user = auth.currentUser;
            if (!user) return;
            
            // Sync path for this specific app (Public collaborative data)
            const docRef = doc(db, 'artifacts', getAppId(), 'public', 'data', 'kurikulumState', 'mainDoc');
            window.firebaseSetDoc = setDoc;
            window.dbRef = docRef;
            
            unsubscribe = onSnapshot(docRef, (snapshot) => {
               if (snapshot.exists()) {
                   setAppData(snapshot.data());
               } else {
                   setDoc(docRef, initialData);
               }
               setIsCloudReady(true);
            }, (error) => {
               console.error("Snapshot error:", error);
            });
            
          } catch(err) {
             console.error("Cloud Init Error:", err);
          }
        };
        initCloud();
        
        return () => {
           if (unsubscribe) unsubscribe();
        };
      }, []);

      // Custom setter to write to Firebase Cloud automatically
      const handleSetData = (updater) => {
         setAppData((prev) => {
            const newData = typeof updater === 'function' ? updater(prev) : updater;
            if (window.firebaseSetDoc && window.dbRef) {
               window.firebaseSetDoc(window.dbRef, newData).catch(err => console.error("Cloud Save Error:", err));
            }
            return newData;
         });
      };

      const showToast = (msg) => {
        setToastMessage(msg);
        setTimeout(() => setToastMessage(''), 3500);
      };

      const handleOpenPdfPreview = (name, data) => {
        setPdfPreview({ isOpen: true, name: name || 'Dokumen.pdf', data: data || '' });
      };

      if (!isAuthenticated) {
        return <LoginScreen onLogin={() => setIsAuthenticated(true)} profil={appData.profil} />;
      }

      const renderContent = () => {
        switch (activeMenu) {
          case 'dashboard': return <DashboardView data={appData} setActiveMenu={setActiveMenu} />;
          case 'kaldik': return <KalenderPendidikanView data={appData} setData={handleSetData} showToast={showToast} searchQuery={searchQuery} onPreviewPdf={handleOpenPdfPreview} />;
          case 'jadwal_pelajaran': return <JadwalPelajaranView data={appData} setData={handleSetData} showToast={showToast} onPreviewPdf={handleOpenPdfPreview} />;
          case 'ksp': return <SimplePdfModule title="Dokumen KSP (Kurikulum Satuan Pendidikan)" docKey="ksp" icon="book" data={appData} setData={handleSetData} showToast={showToast} onPreviewPdf={handleOpenPdfPreview} />;
          case 'rkt': return <SimplePdfModule title="Dokumen RKT & RKAS" docKey="rkt" icon="folder" data={appData} setData={handleSetData} showToast={showToast} onPreviewPdf={handleOpenPdfPreview} />;
          case 'data_guru': return <DataGuruView data={appData} setData={handleSetData} showToast={showToast} searchQuery={searchQuery} />;
          case 'data_siswa': return <DataSiswaView data={appData} setData={handleSetData} showToast={showToast} searchQuery={searchQuery} />;
          case 'perangkat': return <PerangkatAjarView data={appData} searchQuery={searchQuery} />;
          case 'dokumentasi': return <DokumentasiView data={appData} setData={handleSetData} showToast={showToast} searchQuery={searchQuery} />;
          case 'profil_sekolah': return <ProfilSekolahView data={appData} setData={handleSetData} showToast={showToast} />;
          default: return <DashboardView data={appData} setActiveMenu={setActiveMenu} />;
        }
      };

      const getMenuTitle = () => {
        const titles = {
          dashboard: 'Dashboard Utama Kurikulum',
          profil_sekolah: 'Profil & Identitas Sekolah',
          kaldik: 'Manajemen Kalender Pendidikan',
          data_guru: 'Database Tenaga Pendidik',
          data_siswa: 'Data Peserta Didik & Rombel',
          jadwal_pelajaran: 'Jadwal Pelajaran',
          perangkat: 'Perangkat Pembelajaran Guru',
          ksp: 'Kurikulum Satuan Pendidikan (KSP)',
          rkt: 'Rencana Kerja Tahunan (RKT & RKAS)',
          dokumentasi: 'Galeri & Dokumentasi Kegiatan'
        };
        return titles[activeMenu] || 'Aplikasi Kurikulum';
      };

      return (
        <div className="min-h-screen flex flex-col lg:flex-row font-sans text-gray-800" style={{ backgroundColor: clayColors.bgApp }}>
          <Sidebar activeMenu={activeMenu} setActiveMenu={(m) => { setActiveMenu(m); setSearchQuery(''); }} onLogout={() => setIsAuthenticated(false)} isMobileOpen={isMobileOpen} setIsMobileOpen={setIsMobileOpen} profil={appData.profil} />

          <main className="flex-1 min-h-screen p-4 sm:p-6 lg:p-8 overflow-y-auto relative">
            <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 sticky top-0 z-20 py-3 bg-[#F7F4FD]/90 backdrop-blur-md">
              <div className="flex items-center space-x-3">
                <button onClick={() => setIsMobileOpen(!isMobileOpen)} className="lg:hidden p-3 bg-white rounded-2xl shadow-xs text-gray-700">
                  <Icon name="menu" size={20} />
                </button>
                <div>
                  <h1 className="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">{getMenuTitle()}</h1>
                  <p className="text-xs font-bold text-gray-500">{appData.profil.namaSekolah || 'SMP Negeri 1 Pabedilan'} • Portal Administrator</p>
                </div>
              </div>

              <div className="flex items-center space-x-3 w-full sm:w-auto">
                {isCloudReady && (
                   <div className="px-3 py-1.5 bg-emerald-100 text-emerald-700 rounded-full text-[10px] font-black flex items-center space-x-1 shadow-inner border border-white whitespace-nowrap">
                     <Icon name="cloud" size={12} /><span>Tersinkronisasi</span>
                   </div>
                )}
                {['kaldik', 'data_guru', 'data_siswa', 'perangkat', 'dokumentasi'].includes(activeMenu) && (
                  <div className="relative flex-1 sm:w-64">
                    <Icon name="search" className="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400" size={16} />
                    <input type="text" placeholder="Cari data..." className="w-full pl-10 pr-8 py-3 rounded-full bg-white border border-purple-100 shadow-inner focus:outline-none focus:ring-2 focus:ring-[#9B7BEA] text-xs font-bold transition" value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} />
                    {searchQuery && (<button onClick={() => setSearchQuery('')} className="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600"><Icon name="x" size={14} /></button>)}
                  </div>
                )}

                <div className="bg-[#E8DEFA] p-1.5 pr-4 rounded-full flex items-center space-x-2 shadow-xs border border-white flex-shrink-0">
                   <div className="w-8 h-8 bg-white rounded-full flex items-center justify-center font-black text-xs text-purple-800 shadow-xs">
                      <Icon name="user" size={16}/>
                   </div>
                   <span className="text-xs font-black text-purple-900 hidden sm:inline">Kurikulum</span>
                </div>
              </div>
            </div>

            <div className="pb-12">
              {renderContent()}
            </div>
          </main>

          <PdfPreviewModal isOpen={pdfPreview.isOpen} onClose={() => setPdfPreview({ isOpen: false, name: '', data: '' })} pdfName={pdfPreview.name} pdfData={pdfPreview.data} />
          <NotificationToast message={toastMessage} onClose={() => setToastMessage('')} />
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
